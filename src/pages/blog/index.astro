---
import { Image } from "astro:assets";
import BaseHead from "../../components/BaseHead.astro";
import CategoryEyecatch from "../../components/CategoryEyecatch.astro";
import Footer from "../../components/Footer.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import Header from "../../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
import { AUTHORS } from "../../data/authors";
import { getBlogs } from "../../lib/microcms";

const response = await getBlogs({ limit: 100 });
const posts = response.contents;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section>
				<ul
					class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 list-none m-0 p-0 [&>li]:w-full [&>li_*]:no-underline [&>li_*]:transition-all [&>li_*]:duration-200 [&>li:first-child]:col-span-1 md:[&>li:first-child]:col-span-full [&>li:first-child]:mb-0 md:[&>li:first-child]:mb-8"
				>
					{
						posts.map((post) => (
							<li class="group/item">
								<a
									href={`/blog/${post.id}/`}
									class="group block rounded-[20px] bg-bg-secondary/40 backdrop-blur-xl border border-border overflow-hidden transition-all duration-400 ease-[cubic-bezier(0.16,1,0.3,1)] h-full hover:-translate-y-1 hover:scale-[1.02] hover:shadow-md hover:border-text-secondary"
								>
									<div class="flex flex-col md:group-first/item:flex-row md:group-first/item:items-center h-full">
										<div class="w-full aspect-[2/1] overflow-hidden border-b md:group-first/item:border-b-0 md:group-first/item:border-r border-border mb-0 flex-1">
											{post.eyecatch?.url ? (
												<img
													width={720}
													height={360}
													src={post.eyecatch.url}
													alt=""
													class="w-full h-full object-cover rounded-none m-0 border-none transition-transform duration-500 ease-in-out group-hover:scale-105"
												/>
											) : (
												<div class="w-full h-full [&>div]:w-full [&>div]:h-full [&>div]:object-cover [&>div]:rounded-none [&>div]:m-0 [&>div]:border-none [&>div]:transition-transform [&>div]:duration-500 [&>div]:ease-in-out group-hover:[&>div]:scale-105">
													<CategoryEyecatch
														categoryName={
															post.category
																?.name ||
															"Topic"
														}
													/>
												</div>
											)}
										</div>
										<div class="p-6 flex flex-col gap-2 flex-1 md:group-first/item:pl-8">
											<h4 class="m-0 text-text-primary leading-[1.3] font-bold text-xl md:group-first/item:text-4xl transition-colors duration-200 group-hover:text-accent-hover">
												{post.title}
											</h4>
											<div class="flex items-center gap-2 md:gap-4 m-0 text-text-secondary text-sm flex-wrap mt-2">
												<span class="font-mono uppercase tracking-[0.05em] text-text-tertiary">
													<FormattedDate
														date={
															new Date(
																post.publishedAt,
															)
														}
													/>
												</span>
												{post.author &&
												AUTHORS[post.author] ? (
													<span class="inline-flex items-center gap-2 text-text-secondary font-medium">
														<Image
															src={
																AUTHORS[
																	post.author
																].icon
															}
															alt={
																AUTHORS[
																	post.author
																].name
															}
															width={24}
															height={24}
															class="rounded-full border border-border shadow-none m-0"
														/>
														{
															AUTHORS[post.author]
																.name
														}
													</span>
												) : (
													post.author && (
														<span class="inline-flex items-center gap-2 text-text-secondary font-medium">
															✍️ {post.author}
														</span>
													)
												)}
											</div>
										</div>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
