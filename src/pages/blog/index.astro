---
import { Image } from "astro:assets";
import BaseHead from "../../components/BaseHead.astro";
import CategoryEyecatch from "../../components/CategoryEyecatch.astro";
import Footer from "../../components/Footer.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import Header from "../../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
import { AUTHORS } from "../../data/authors";
import { getBlogs } from "../../lib/microcms";

const response = await getBlogs({ limit: 100 });
const posts = response.contents;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.blog-list {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			.blog-list li {
				width: 100%;
			}
			.blog-list li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			/* Apply special styles to the first list item */
			.blog-list li:first-child {
				grid-column: 1 / -1;
				margin-bottom: 2rem;
			}

			/* First item card logic */
			.blog-list li:first-child .post-card-inner {
				display: flex;
				flex-direction: column;
			}

			@media (min-width: 768px) {
				.blog-list li:first-child .post-card-inner {
					flex-direction: row;
					align-items: center;
				}
				.blog-list li:first-child .post-image {
					flex: 1;
					margin-bottom: 0;
				}
				.blog-list li:first-child .post-content {
					flex: 1;
					padding-left: 2rem;
				}
				.blog-list li:first-child .title {
					font-size: 2.5rem;
				}
			}

			.post-card {
				display: block;
				border-radius: 20px;
				background-color: rgba(
					var(--bg-secondary-rgb, 255, 255, 255),
					0.4
				);
				backdrop-filter: blur(16px);
				border: 1px solid var(--border-color);
				overflow: hidden;
				transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
				height: 100%;
			}
			.post-card:hover {
				transform: translateY(-4px) scale(1.02);
				box-shadow: var(--shadow-md);
				border-color: var(--text-secondary);
			}

			.post-image {
				width: 100%;
				aspect-ratio: 2 / 1;
				overflow: hidden;
				border-bottom: 1px solid var(--border-color);
				margin-bottom: 0;
				display: block;
			}
			.post-image img,
			.post-image :global(.fallback-eyecatch) {
				width: 100%;
				height: 100%;
				object-fit: cover;
				border-radius: 0;
				margin: 0;
				border: none;
				transition: transform 0.5s ease;
			}

			.post-card:hover .post-image img,
			.post-card:hover .post-image :global(.fallback-eyecatch) {
				transform: scale(1.05);
			}

			.post-content {
				padding: 1.5rem;
				display: flex;
				flex-direction: column;
				gap: 0.5rem;
			}

			.title {
				margin: 0;
				color: var(--text-primary);
				line-height: 1.3;
				font-weight: 700;
				font-size: 1.25rem;
				transition: color 0.2s ease;
			}
			.post-card:hover .title {
				color: var(--accent-hover);
			}

			.meta {
				display: flex;
				align-items: center;
				gap: 1rem;
				margin: 0;
				color: var(--text-secondary);
				font-size: 0.875rem;
				flex-wrap: wrap;
			}

			.date {
				font-family: var(--font-mono);
				text-transform: uppercase;
				letter-spacing: 0.05em;
				color: var(--text-tertiary);
			}

			.author-info {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				color: var(--text-secondary);
				font-weight: 500;
			}
			.author-avatar {
				border-radius: 50%;
				border: 1px solid var(--border-color);
			}

			@media (max-width: 720px) {
				.blog-list {
					grid-template-columns: 1fr;
					gap: 1.5rem;
				}
				.blog-list li {
					text-align: left;
				}
				.blog-list li:first-child {
					margin-bottom: 0;
					text-align: left;
				}
				.blog-list li:first-child .title {
					font-size: 1.5rem;
				}
				.meta {
					gap: 0.5rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<ul class="blog-list">
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`} class="post-card">
									<div class="post-card-inner">
										<div class="post-image">
											{post.eyecatch?.url ? (
												<img
													width={720}
													height={360}
													src={post.eyecatch.url}
													alt=""
												/>
											) : (
												<CategoryEyecatch
													categoryName={
														post.category?.name ||
														"Topic"
													}
												/>
											)}
										</div>
										<div class="post-content">
											<h4 class="title">{post.title}</h4>
											<div class="meta">
												<span class="date">
													<FormattedDate
														date={
															new Date(
																post.publishedAt,
															)
														}
													/>
												</span>
												{post.author &&
												AUTHORS[post.author] ? (
													<span class="author-info">
														<Image
															src={
																AUTHORS[
																	post.author
																].icon
															}
															alt={
																AUTHORS[
																	post.author
																].name
															}
															width={24}
															height={24}
															class="author-avatar"
														/>
														{
															AUTHORS[post.author]
																.name
														}
													</span>
												) : (
													post.author && (
														<span class="author-info">
															✍️ {post.author}
														</span>
													)
												)}
											</div>
										</div>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
