---
import { Calendar, RefreshCw } from "lucide-astro";

interface Props {
	date: Date;
	type?: "published" | "updated" | "none";
}

const { date, type = "none" } = Astro.props;
---

<time
	datetime={date.toISOString()}
	class="inline-flex items-center gap-1.5 align-middle"
>
	{type === "published" && <Calendar size={14} class="opacity-70" />}
	{type === "updated" && <RefreshCw size={14} class="opacity-70" />}
	<span>
		{
			date
				.toLocaleDateString("ja-JP", {
					year: "numeric",
					month: "2-digit",
					day: "2-digit",
				})
				.replace(/\//g, ".")
		}
	</span>
</time>
