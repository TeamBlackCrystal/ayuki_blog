---
import { Image } from "astro:assets";
import BaseHead from "../components/BaseHead.astro";
import CategoryEyecatch from "../components/CategoryEyecatch.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import { AUTHORS } from "../data/authors";

type Props = {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: string;
	author?: string;
	categoryName?: string;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	author,
	categoryName,
} = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head><body class="bg-bg-primary text-text-primary">
		<Header />
		<main class="max-w-[800px] mx-auto p-4 sm:p-8">
			<article
				class="bg-bg-primary rounded-2xl border border-border overflow-hidden shadow-sm"
			>
				<div class="w-full">
					{
						heroImage ? (
							<img
								width={1020}
								height={510}
								src={heroImage}
								alt=""
								class="block mx-auto rounded-none w-full max-h-[480px] object-cover"
							/>
						) : (
							<div class="[&>div]:block [&>div]:mx-auto [&>div]:w-full [&>div]:max-h-[480px] [&>div]:object-cover [&>div]:rounded-none">
								<CategoryEyecatch
									categoryName={categoryName || "Topic"}
								/>
							</div>
						)
					}
				</div>
				<div
					class="w-full p-8 sm:py-12 sm:px-8 text-text-secondary box-border [&_p]:leading-loose [&_p]:tracking-[0.05em] [&_p]:mb-8 [&_h2]:tracking-[0.03em] [&_h2]:mt-12 [&_h2]:mb-6 [&_h3]:tracking-[0.03em] [&_h3]:mt-12 [&_h3]:mb-6 [&_li]:leading-[1.8] [&_li]:tracking-[0.04em] [&_li]:mb-3 [&_hr]:my-10 [&_hr]:border-border [&_hr]:opacity-50"
				>
					<div class="mb-10 text-center">
						<div
							class="text-text-tertiary text-sm font-mono uppercase tracking-[0.05em] font-medium"
						>
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="italic mt-2">
										Last updated on{" "}
										<FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1
							class="my-2 mb-6 text-text-primary text-[2rem] sm:text-[2.5rem] tracking-[-0.03em] leading-tight"
						>
							{title}
						</h1>
						{
							author && AUTHORS[author as keyof typeof AUTHORS]
								? (() => {
										const authorData =
											AUTHORS[
												author as keyof typeof AUTHORS
											];
										return (
											<div class="flex items-center justify-center gap-2 text-text-secondary font-medium text-[0.95rem]">
												<Image
													src={authorData.icon}
													alt={authorData.name}
													width={32}
													height={32}
													class="rounded-full shadow-none border border-border"
												/>
												<span>{authorData.name}</span>
											</div>
										);
									})()
								: author && (
										<div class="flex items-center justify-center gap-2 text-text-secondary font-medium text-[0.95rem]">
											✍️ {author}
										</div>
									)
						}
						<hr class="my-10 border-border opacity-50" />
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
