---
import { Image } from "astro:assets";
import BaseHead from "../components/BaseHead.astro";
import CategoryEyecatch from "../components/CategoryEyecatch.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import { AUTHORS } from "../data/authors";

type Props = {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: string;
	author?: string;
	categoryName?: string;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	author,
	categoryName,
} = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				max-width: 800px;
				margin: 0 auto;
				padding: 2rem 1.5rem;
			}
			article {
				background-color: var(--bg-primary);
				border-radius: 16px;
				border: 1px solid var(--border-color);
				overflow: hidden;
				box-shadow: var(--shadow-sm);
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img,
			.hero-image :global(.fallback-eyecatch) {
				display: block;
				margin: 0 auto;
				border-radius: 0;
				width: 100%;
				max-height: 480px;
				object-fit: cover;
			}
			.prose {
				width: 100%;
				padding: 3rem 2rem;
				color: var(--text-secondary);
				box-sizing: border-box;
			}
			.prose :global(p) {
				line-height: 2;
				letter-spacing: 0.05em;
				margin-bottom: 2rem;
			}
			.prose :global(h2),
			.prose :global(h3) {
				letter-spacing: 0.03em;
				margin-top: 3rem;
				margin-bottom: 1.5rem;
			}
			.prose :global(li) {
				line-height: 1.8;
				letter-spacing: 0.04em;
				margin-bottom: 0.75rem;
			}
			.title {
				margin-bottom: 2.5rem;
				text-align: center;
			}
			.title h1 {
				margin: 0.5rem 0 1.5rem 0;
				color: var(--text-primary);
				font-size: 2.5rem;
				letter-spacing: -0.03em;
				line-height: 1.2;
			}
			.date {
				color: var(--text-tertiary);
				font-size: 0.875rem;
				font-family: var(--font-mono);
				text-transform: uppercase;
				letter-spacing: 0.05em;
				font-weight: 500;
			}
			.last-updated-on {
				font-style: italic;
				margin-top: 0.5rem;
			}
			.author {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 0.5rem;
				color: var(--text-secondary);
				font-weight: 500;
				font-size: 0.95rem;
			}
			.prose :global(hr) {
				margin: 2.5rem 0;
				border-color: var(--border-color);
				opacity: 0.5;
			}
			@media (max-width: 640px) {
				main {
					padding: 1rem;
				}
				.prose {
					padding: 2rem 1rem;
				}
				.title h1 {
					font-size: 2rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{
						heroImage ? (
							<img
								width={1020}
								height={510}
								src={heroImage}
								alt=""
							/>
						) : (
							<CategoryEyecatch
								categoryName={categoryName || "Topic"}
							/>
						)
					}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on{" "}
										<FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						{
							author && AUTHORS[author as keyof typeof AUTHORS]
								? (() => {
										const authorData =
											AUTHORS[
												author as keyof typeof AUTHORS
											];
										return (
											<div class="author">
												<Image
													src={authorData.icon}
													alt={authorData.name}
													width={32}
													height={32}
													style="border-radius: 50%;"
												/>
												<span>{authorData.name}</span>
											</div>
										);
									})()
								: author && (
										<div class="author">✍️ {author}</div>
									)
						}
						<hr />
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
